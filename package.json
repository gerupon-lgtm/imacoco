{
  "name": "imakoko-info",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "data:municipalities": "node scripts/generate-gsi-municipalities.mjs",
    "data:stations": "node scripts/generate-stations.mjs",
    "data:medical": "node scripts/generate-medical.mjs",
    "data:government": "node scripts/generate-government.mjs",
    "data:validate": "node scripts/validate-static-data.mjs",
    "version:check": "node scripts/check-version.mjs",
    "security:check": "node scripts/check-security.mjs",
    "manifest:check": "node scripts/check-pwa-manifest.mjs",
    "check": "npm run version:check && npm run security:check && npm run data:validate && npm run typecheck && npm test && npm run build && npm run manifest:check"
  },
  "dependencies": {
    "@fontsource/kosugi": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "fflate": "^0.8.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
